"""Primary playable gameplay scene."""

from typing import Protocol

from ...core.constants import SCREEN_HEIGHT, SCREEN_WIDTH
from ...core.state import GameState
from ..simulation import update_simulation
from .base import Scene


class InputProvider(Protocol):
    """Protocol for abstracting keyboard/controller input for the scene."""

    def get_horizontal_axis(self) -> float:
        """Return horizontal movement in [-1.0, 1.0]."""
        ...


class PlayScene(Scene):
    """Coordinates gameplay state transitions with decoupled input."""

    def __init__(self, input_provider: InputProvider) -> None:
        self._state = GameState.initial(float(SCREEN_WIDTH), float(SCREEN_HEIGHT))
        self._input_provider = input_provider

    def update(self, dt: float) -> None:
        """Advance play scene simulation."""
        move = self._input_provider.get_horizontal_axis()
        self._state = update_simulation(self._state, move, dt)

    @property
    def state(self) -> GameState:
        """Return the current game state."""
        return self._state
