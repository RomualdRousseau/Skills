"""Tests for Silver transformations and Gold analytical aggregations."""

from datetime import UTC, datetime

from {{ package_name }}.application.model.schemas import RawTransaction
from {{ package_name }}.application.stage.business_view import aggregate_business_metrics
from {{ package_name }}.application.stage.core_model import transform_to_core_model


def test_silver_deduplication_keeps_latest() -> None:
    """Verify deduplication keeps the record with latest timestamp."""
    records = [
        RawTransaction(
            transaction_id="T1",
            user_id="U1",
            amount=20.0,
            currency="usd",
            timestamp=datetime(2026, 1, 1, 10, 0, 0, tzinfo=UTC),
        ),
        RawTransaction(
            transaction_id="T1",  # duplicate, newer timestamp
            user_id="U1",
            amount=25.0,
            currency="usd",
            timestamp=datetime(2026, 1, 1, 12, 0, 0, tzinfo=UTC),
        ),
    ]

    silver = transform_to_core_model(records)

    assert len(silver) == 1
    row = silver.to_dicts()[0]
    assert row["amount"] == 25.0
    assert row["currency"] == "USD"


def test_gold_aggregation_by_user() -> None:
    """Verify DuckDB SQL aggregation totals per user."""
    records = [
        RawTransaction(
            transaction_id="T1",
            user_id="U1",
            amount=100.0,
            currency="USD",
            timestamp=datetime(2026, 1, 1, 10, 0, 0, tzinfo=UTC),
        ),
        RawTransaction(
            transaction_id="T2",
            user_id="U1",
            amount=50.0,
            currency="USD",
            timestamp=datetime(2026, 1, 1, 11, 0, 0, tzinfo=UTC),
        ),
        RawTransaction(
            transaction_id="T3",
            user_id="U2",
            amount=75.0,
            currency="EUR",
            timestamp=datetime(2026, 1, 1, 12, 0, 0, tzinfo=UTC),
        ),
    ]

    silver = transform_to_core_model(records)
    gold = aggregate_business_metrics(silver)

    assert len(gold) == 2
    u1_row = [r for r in gold.to_dicts() if r["user_id"] == "U1"][0]
    assert u1_row["total_volume"] == 150.0
    assert u1_row["transaction_count"] == 2
