[project]
name = "{{ package_name }}"
version = "0.1.0"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">=3.11"
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" }
]
dependencies = [
    "{{ package_name }}-env",
    "{{ package_name }}-agents",
]

[tool.uv]
package = false

[tool.uv.sources]
{{ package_name }}-env = { workspace = true }
{{ package_name }}-agents = { workspace = true }

[tool.uv.workspace]
members = ["packages/*"]

[dependency-groups]
dev = [
    "pytest>=8.0.0",
    "hypothesis>=6.100.0",
    "ruff>=0.5.0",
]

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = [
    "E",
    "W",
    "F",
    "I",
    "B",
    "C4",
    "UP",
    "SIM",
]

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}_env", "{{ package_name }}_agents"]

[tool.pytest.ini_options]
testpaths = ["packages/*/tests"]
python_files = ["test_*.py"]
addopts = "-ra --strict-markers --import-mode=importlib"
