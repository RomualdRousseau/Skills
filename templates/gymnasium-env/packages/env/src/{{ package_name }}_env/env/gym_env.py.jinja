"""Farama Gymnasium environment adhering to skills/gymnasium-env contract."""

from typing import Any

import gymnasium as gym
import numpy as np
from gymnasium import spaces

from {{ package_name }}_env.core.constants import (
    MAX_POSITION,
    MAX_VELOCITY,
    MIN_POSITION,
)
from {{ package_name }}_env.core.physics import PhysicsState, step_physics
from {{ package_name }}_env.env.reward import TARGET_THRESHOLD, calculate_reward


class CustomEnv(gym.Env):
    """1D Target Reaching Gymnasium Environment."""

    metadata = {"render_modes": ["human", "rgb_array"], "render_fps": 20}

    def __init__(self, render_mode: str | None = None, max_steps: int = 100) -> None:
        super().__init__()
        self.render_mode = render_mode
        self.max_steps = max_steps

        # Action: 0: Left, 1: None, 2: Right
        self.action_space = spaces.Discrete(3)

        # Observation: [position, velocity]
        self.observation_space = spaces.Box(
            low=np.array([MIN_POSITION, -MAX_VELOCITY], dtype=np.float32),
            high=np.array([MAX_POSITION, MAX_VELOCITY], dtype=np.float32),
            dtype=np.float32,
        )

        self._state: PhysicsState | None = None
        self._renderer: Any = None

    def _get_obs(self) -> np.ndarray:
        assert self._state is not None
        return np.array([self._state.position, self._state.velocity], dtype=np.float32)

    def _get_info(self) -> dict[str, Any]:
        assert self._state is not None
        dist = abs(self._state.position - self._state.target)
        return {
            "distance_to_target": float(dist),
            "step_count": self._state.step_count,
        }

    def reset(
        self, *, seed: int | None = None, options: dict[str, Any] | None = None
    ) -> tuple[np.ndarray, dict[str, Any]]:
        """Reset environment to initial state."""
        super().reset(seed=seed)

        # Deterministic initialization based on seeded RNG
        initial_pos = float(self.np_random.uniform(-2.0, 2.0))
        target_pos = float(self.np_random.choice([-5.0, 5.0]))

        self._state = PhysicsState(
            position=initial_pos,
            velocity=0.0,
            target=target_pos,
            step_count=0,
        )

        obs = self._get_obs()
        info = self._get_info()
        return obs, info

    def step(self, action: int) -> tuple[np.ndarray, float, bool, bool, dict[str, Any]]:
        """Advance simulation by one action step."""
        if self._state is None:
            raise RuntimeError("reset() must be called before step().")

        old_state = self._state
        self._state = step_physics(old_state, action)

        reward = calculate_reward(old_state, action, self._state)
        dist = abs(self._state.position - self._state.target)
        reached_target = dist < TARGET_THRESHOLD

        terminated = reached_target
        truncated = self._state.step_count >= self.max_steps

        obs = self._get_obs()
        info = self._get_info()

        if self.render_mode == "human":
            self.render()

        return obs, reward, terminated, truncated, info

    def render(self) -> Any:
        """Render frame using Raylib visual renderer."""
        if self.render_mode is None:
            return None

        if self._renderer is None:
            from {{ package_name }}_env.engine.renderer import RaylibRenderer

            self._renderer = RaylibRenderer()
            self._renderer.init_window()

        if self._state is not None:
            self._renderer.render(self._state)

    def close(self) -> None:
        """Clean up rendering resources."""
        if self._renderer is not None:
            self._renderer.close()
            self._renderer = None
