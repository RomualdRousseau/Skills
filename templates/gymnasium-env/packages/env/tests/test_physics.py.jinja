"""Tests validating physics dynamics, invariants, and determinism."""

import numpy as np
from hypothesis import given
from hypothesis import strategies as st

from {{ package_name }}_env.core.constants import MAX_POSITION, MAX_VELOCITY, MIN_POSITION
from {{ package_name }}_env.core.physics import PhysicsState, step_physics
from {{ package_name }}_env.env.gym_env import CustomEnv


def test_seed_reproducibility() -> None:
    """Verify that identical seeds produce identical initial states and trajectories."""
    env1 = CustomEnv(render_mode=None)
    env2 = CustomEnv(render_mode=None)

    obs1, _ = env1.reset(seed=123)
    obs2, _ = env2.reset(seed=123)

    np.testing.assert_allclose(obs1, obs2)

    # Step both with identical discrete actions
    for action in [0, 2, 1, 0, 2]:
        next_obs1, r1, _, _, _ = env1.step(action)
        next_obs2, r2, _, _, _ = env2.step(action)
        np.testing.assert_allclose(next_obs1, next_obs2)
        assert r1 == r2

    env1.close()
    env2.close()


def test_different_seeds_produce_different_states() -> None:
    """Verify different seeds yield distinct initial states."""
    env = CustomEnv(render_mode=None)
    obs1, _ = env.reset(seed=1)
    obs2, _ = env.reset(seed=2)

    assert not np.allclose(obs1, obs2)
    env.close()


@given(
    pos=st.floats(min_value=MIN_POSITION, max_value=MAX_POSITION),
    vel=st.floats(min_value=-MAX_VELOCITY, max_value=MAX_VELOCITY),
    action=st.integers(min_value=0, max_value=2),
)
def test_physics_invariants(pos: float, vel: float, action: int) -> None:
    """Hypothesis property test verifying state bounds remain invariant."""
    state = PhysicsState(position=pos, velocity=vel, target=0.0, step_count=0)
    next_state = step_physics(state, action)

    assert MIN_POSITION <= next_state.position <= MAX_POSITION
    assert -MAX_VELOCITY <= next_state.velocity <= MAX_VELOCITY
    assert next_state.step_count == 1
